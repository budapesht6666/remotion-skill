# ============================================================
#  Скопируй в .env и заполни. Ключи НИКОГДА не коммитим (.env в .gitignore).
#  Всё опционально: пустой ключ = провайдер просто пропускается в фолбэке.
#  Сценарий/текст ролика пишет сам Claude — LLM-ключи здесь НЕ нужны.
# ============================================================

# ---------- Бесплатный сток (картинки/видео-фон) ----------
# Фото. https://unsplash.com/developers  (Access Key из твоего приложения)
UNSPLASH_ACCESS_KEY=

# Фото + видео. https://www.pexels.com/api/  (200 req/час, 20k/мес)
PEXELS_API_KEY=

# Фото + видео, резерв. https://pixabay.com/api/docs/  (100 req/60с)
PIXABAY_API_KEY=

# Фолбэк-цепочка: фото Unsplash → Pexels → Pixabay; видео Pexels → Pixabay.

# ---------- (Опционально, на будущее) Озвучка TTS ----------
# Подключается по запросу. Порядок текст → TTS → public/*.mp3 → <Audio>.
# ElevenLabs: лучшее качество, отличный русский. https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Бесплатный fallback без ключа — edge-tts (голоса, напр. ru-RU-DmitryNeural).
EDGE_VOICE_RU=ru-RU-DmitryNeural
EDGE_VOICE_EN=en-US-GuyNeural

GROQ_API_KEY=...     # console.groq.com/keys — транскрипция фильма за ~2 минуты
GEMINI_API_KEY=...   # aistudio.google.com/apikey — индекс действий по видео
